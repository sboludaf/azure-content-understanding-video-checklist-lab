# azd provision supplies these App Service settings automatically.
# The application has no synthetic/demo mode. Deploy to your own Azure account.
MVP_MODE=azure
MVP_RUNTIME_PROFILE=azd
MVP_RUNTIME_DIR=/home/video-checklist
MVP_AZURE_PROVIDER=azure_foundry_responses
MVP_AZURE_CREDENTIAL_MODE=managed_identity
MVP_AZURE_ENDPOINT=
MVP_AZURE_DEPLOYMENT_NAME=video-checklist
MVP_AZURE_MODEL=gpt-6.1-sol
MVP_AZURE_MODEL_VERSION=2026-09-29
MVP_AZURE_REGION=
MVP_AZURE_TENANT_ID=
MVP_AZURE_PRINCIPAL_ID=
MVP_ALLOWED_HOSTS=
MVP_BASE_URL=
# Finite local safeguards. These are usage limits, not an Azure monetary budget.
MVP_MAX_ANALYSES=1000
MVP_MAX_TOTAL_MINUTES=1500
# Only set AZURE_CLIENT_ID if you replace the default system-assigned identity.
