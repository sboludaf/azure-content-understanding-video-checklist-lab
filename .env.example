# Default is a LOCAL illustrative fixture, never independent QA or Azure evidence.
MVP_MODE=fixture
# Durable private state OUTSIDE Git and the vault. Use one shared path across both roles.
MVP_RUNTIME_DIR=/private/tmp/mvp-labs/2026-10-15-content-understanding-video-checklist/app
MVP_SAMPLE_PATH=/private/tmp/mvp-labs/2026-10-15-content-understanding-video-checklist/media/base.mp4
# Azure remains disabled unless every field and a matching human authorization exists.
MVP_AUTHORIZATION_PATH=
MVP_LEDGER_PATH=
MVP_AZURE_ENDPOINT=
MVP_AZURE_TENANT_ID=
MVP_AZURE_PRINCIPAL_ID=
MVP_AZURE_RESOURCE_ID=
MVP_AZURE_ANALYZER_ID=
MVP_AZURE_MODEL=
MVP_AZURE_SCHEMA_HASH=
MVP_ROLE=implementer
MVP_EXPECTED_COMMIT=
MVP_AZURE_CREDENTIAL_MODE=azure_cli
# A clean Tester clone uses the hosted canonical ledger, never a new balance.
MVP_LEDGER_URL=
MVP_LEDGER_RELAY_TOKEN_PATH=
